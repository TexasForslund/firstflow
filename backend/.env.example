# Kopiera till backend/.env och justera vid behov.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://firstflow:firstflow@localhost:5432/firstflow
CORS_ORIGINS=["http://localhost:5173"]
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_DAYS=14

# Länkar i mejl, t.ex. inbjudningar
FRONTEND_URL=http://localhost:5173
# E-post. Lämna SMTP_HOST tomt så skrivs mejlen till loggen (utveckling).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Firstflow <noreply@firstflow.se>
